{
  "name": "instagram-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server for the Instagram API with Instagram Login: profile, media, insights, comments, publishing and direct messages",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "instagram",
    "instagram-graph-api",
    "social-media",
    "claude"
  ],
  "license": "MIT",
  "author": "OraCool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OraCool/instagram-mcp.git"
  },
  "homepage": "https://github.com/OraCool/instagram-mcp#readme",
  "bugs": {
    "url": "https://github.com/OraCool/instagram-mcp/issues"
  },
  "type": "module",
  "bin": {
    "instagram-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "docs/credentials.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "login": "node --env-file-if-exists=.env dist/index.js login",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "inspect": "npx @modelcontextprotocol/inspector node --env-file-if-exists=.env dist/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
