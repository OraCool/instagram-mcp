# Long-lived Instagram User access token (Instagram API with Instagram Login). See docs/credentials.md.
IG_ACCESS_TOKEN=
# Optional: Instagram professional account id. Resolved from GET /me when empty.
IG_USER_ID=
# Graph API version used in request paths.
IG_API_VERSION=v25.0
# JSON file where login/refreshed tokens are stored (default ~/.config/instagram-mcp/token.json).
# When the file exists, its token takes precedence over IG_ACCESS_TOKEN.
IG_TOKEN_CACHE_PATH=
# Several accounts: one MCP server entry per account with its own IG_ACCOUNT (token file <name>.token.json).
IG_ACCOUNT=
# false (default) => publishing, comment replies/hide/delete and sending messages are refused.
IG_ENABLE_WRITES=false

# --- `instagram-mcp login` (instead of pasting IG_ACCESS_TOKEN) ---
# Option 1: your own Meta app. Register IG_REDIRECT_URI as a valid OAuth redirect URI in the app.
IG_APP_ID=
IG_APP_SECRET=
# Defaults to https://oracool.github.io/instagram-mcp/callback/
IG_REDIRECT_URI=
# Option 2: a hosted login server (worker/) run by the app owner; you need to be added to their app.
IG_AUTH_SERVER=
